{
  "name": "melon-db",
  "version": "0.1.0",
  "private": false,
  "description": "Typed helpers for WatermelonDB: less write() boilerplate, safer collection access, safer database resets.",
  "license": "MIT",
  "author": "Alzen",
  "keywords": [
    "watermelondb",
    "react-native",
    "expo",
    "sqlite",
    "offline",
    "database",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alzenware/melon-db.git"
  },
  "bugs": {
    "url": "https://github.com/alzenware/melon-db/issues"
  },
  "homepage": "https://github.com/alzenware/melon-db#readme",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@nozbe/watermelondb": ">=0.27.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@nozbe/watermelondb": "^0.28.0",
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "typescript": "~5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/index.ts",
    "./lib/index.js"
  ]
}
